+struct ScannerEntry {
+    kind: usize,
+    scanner: Scanner,
+}
+
+/// Most grammars use at most two stateful matchers. Keep their handles inline, retaining
+/// lazy creation and the original token-index drop order, with no limit on larger tables.
+struct ScannerStates {
+    inline: [Option<ScannerEntry>; 4],
+    overflow: Vec<ScannerEntry>,
+    len: usize,
+}
+
+impl ScannerStates {
+    fn new() -> Self {
+        Self { inline: std::array::from_fn(|_| None), overflow: Vec::new(), len: 0 }
+    }
+
+    fn get(&mut self, kind: usize, make: fn() -> Scanner) -> &mut Scanner {
+        if self.len <= self.inline.len() {
+            let at = self.inline[..self.len].partition_point(|entry| entry.as_ref().unwrap().kind < kind);
+            if at < self.len && self.inline[at].as_ref().unwrap().kind == kind {
+                return &mut self.inline[at].as_mut().unwrap().scanner;
+            }
+            // Invoke a fallible factory before moving any live state. If it panics, existing
+            // handles still drop in the same order as the original type-indexed vector.
+            let scanner = make();
+            if self.len < self.inline.len() {
+                self.inline[at..=self.len].rotate_right(1);
+                self.inline[at] = Some(ScannerEntry { kind, scanner });
+                self.len += 1;
+                return &mut self.inline[at].as_mut().unwrap().scanner;
+            }
+            self.overflow = Vec::with_capacity(self.inline.len() * 2);
+            for entry in &mut self.inline {
+                self.overflow.push(entry.take().unwrap());
+            }
+            self.overflow.insert(at, ScannerEntry { kind, scanner });
+            self.len += 1;
+            return &mut self.overflow[at].scanner;
+        }
+        match self.overflow.binary_search_by_key(&kind, |entry| entry.kind) {
+            Ok(at) => &mut self.overflow[at].scanner,
+            Err(at) => {
+                let scanner = make();
+                self.overflow.insert(at, ScannerEntry { kind, scanner });
+                self.len += 1;
+                &mut self.overflow[at].scanner
+            }
+        }
+    }
+}
