+//! The strict crossing definition is independent of the frequency-tree representation.
+use super::count_inversions;
+
+fn pairwise(targets: &[usize]) -> i64 {
+    let mut total = 0;
+    for i in 0..targets.len() {
+        for j in i + 1..targets.len() {
+            if targets[i] > targets[j] {
+                total += 1;
+            }
+        }
+    }
+    total
+}
+
+#[test]
+fn inversion_counts_preserve_order_duplicates_and_dirty_scratch() {
+    let mut tree = vec![93i64; 65];
+    for targets in [vec![], vec![0], vec![0, 0, 0], vec![3, 2, 1, 0], vec![0, 1, 2, 3], vec![3, 0, 3, 0]] {
+        assert_eq!(count_inversions(&targets, 4, &mut tree), pairwise(&targets));
+    }
+    let mut seed = 0x11c0de_u32;
+    let mut next = || {
+        seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+        seed
+    };
+    for case in 0..2048 {
+        let positions = 1 + (next() % 64) as usize;
+        let len = (next() % 129) as usize;
+        let targets: Vec<_> = (0..len).map(|_| next() as usize % positions).collect();
+        assert_eq!(count_inversions(&targets, positions, &mut tree), pairwise(&targets), "case {case}");
+    }
+}
