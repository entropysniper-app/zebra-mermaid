+/// Counts strictly inverted targets in their original order. The Fenwick tree stores the
+/// same integer frequencies as the crossing counter's former segment tree.
+fn count_inversions(targets: &[usize], positions: usize, tree: &mut [i64]) -> i64 {
+    tree[..=positions].fill(0);
+    let mut total = 0i64;
+    for (seen, &target) in targets.iter().enumerate() {
+        let mut at = target + 1;
+        let mut not_after = 0i64;
+        while at > 0 {
+            not_after += tree[at];
+            at &= at - 1;
+        }
+        // An allocated target slice has fewer than i64::MAX entries.
+        total += seen as i64 - not_after;
+        let mut at = target + 1;
+        while at <= positions {
+            tree[at] += 1;
+            at += at & at.wrapping_neg();
+        }
+    }
+    total
+}
